        {
          "marko" : "om.0o",
          "teksto" : "[PERS] Germanlingve: , 1787-1854; germana <a href=\"fizik.0isto\">fizikisto<\/a>, malkovrinta la leĝon pri proporcieco de elektra tensio kaj kurentintenso (tiu leĝo nun estas nomata „la leĝo de Omo“).",
          "titolo" : "Omo"
        },
        {
          "marko" : "om.o0o",
          "teksto" : "[ELE] <a href=\"unu.mezur0o\">Mezurunuo<\/a> de <a href=\"rezist1.0o\">rezistanco<\/a> en la Internacia Sistemo de unuoj: <i>unu <b>om<\/b>o egalas al la rezistanco de kondukilo, kiu tralasas kurenton de unu <a href=\"amper.a0o\">ampero<\/a> sub tensio de unu <a href=\"volt.v0o\">volto<\/a>.<\/i>",
          "titolo" : "omo"
        },
        {
          "marko" : "om.o0metro",
          "teksto" : "[ELE] <a href=\"unu.mezur0o\">Mezurunuo<\/a> de <a href=\"rezist2.0o\">rezistivo<\/a> en la Internacia Sistemo de unuoj: <i>unu <b>om<\/b>ometro egalas al la rezistivo de tia materio, ke cilindra kondukilo el ĝi kun orta sekco je unu <a href=\"metr.kvadrata0o\">kvadrata metro<\/a>, kaj longo je unu <a href=\"metr.0o.unuo\">metro<\/a>, havas <a href=\"rezist1.0o\">rezistancon<\/a> je unu <a href=\"om.o0o\">omo<\/a>.<\/i>\n<b>Rim<\/b>: Oni ankaŭ nomas aparaton por mezuri la rezistancon „<a href=\"ommetr\">ommetro<\/a>“.",
          "titolo" : "omometro, ommetro"
        }
      ]
